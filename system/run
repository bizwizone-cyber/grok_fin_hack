# Longer names first when scanning free text.
_COUNTRY_SCAN = tuple(sorted(
    ((k, v) for k, v in COUNTRY_MAP.items() if len(k) >= 4 and not k.isalpha() or len(k) >= 5 or " " in k or "'" in k or k in {
        "spain", "france", "italy", "china", "india", "japan", "brazil", "ghana",
        "kenya", "sudan", "syria", "yemen", "egypt", "haiti", "malta", "peru",
        "chile", "nepal", "qatar", "oman", "togo", "mali", "chad", "fiji", "cuba",
        "iran", "iraq", "laos", "fiji", "tonga", "samoa", "benin", "niger",
        "gabon", "libya", "nigeria", "germany", "ireland", "poland", "canada",
        "mexico", "sweden", "norway", "denmark", "austria", "greece", "turkey",
        "cyprus", "serbia", "panama", "jordan", "kuwait", "bahrain", "lebanon",
        "morocco", "algeria", "tunisia", "senegal", "uganda", "zambia", "angola",
        "rwanda", "malawi", "namibia", "liberia", "guinea", "gambia", "eritrea",
        "djibouti", "burundi", "lesotho", "vanuatu", "brunei", "bhutan", "moldova",
        "albania", "kosovo", "belarus", "ukraine", "georgia", "armenia", "romania",
        "bulgaria", "croatia", "slovakia", "slovenia", "hungary", "finland",
        "iceland", "estonia", "latvia", "lithuania", "portugal", "belgium",
        "pakistan", "thailand", "vietnam", "malaysia", "myanmar", "cambodia",
        "mongolia", "ethiopia", "tanzania", "somalia", "zimbabwe", "cameroon",
        "colombia", "ecuador", "bolivia", "paraguay", "uruguay", "honduras",
        "nicaragua", "guatemala", "barbados", "bahamas", "jamaica", "suriname",
        "guyana", "belize", "andorra", "monaco", "gibraltar", "bermuda", "guam",
        "taiwan", "israel", "russia", "mexico", "singapore",
    }),
    key=lambda kv: -len(kv[0]),
))
# Simpler: all aliases length >= 4 except iso-looking
_COUNTRY_SCAN = tuple(sorted(
    ((k, v) for k, v in COUNTRY_MAP.items() if len(k) >= 4),
    key=lambda kv: -len(kv[0]),
))


# Letters NFKD does not decompose: fold them like accents so "Weiß"=="Weiss", "Østergaard"=="Ostergaard".
_FOLD_EXTRA = str.maketrans({
    "ß": "ss", "ẞ": "SS", "ø": "o", "Ø": "O", "æ": "ae", "Æ": "AE", "œ": "oe", "Œ": "OE",
    "đ": "d", "Đ": "D", "ð": "d", "Ð": "D", "ł": "l", "Ł": "L", "ı": "i", "İ": "I",
    "þ": "th", "Þ": "TH", "ħ": "h", "Ħ": "H",
})


def _fold(text):
    text = str(text).translate(_FOLD_EXTRA)
    return "".join(ch for ch in unicodedata.normalize("NFKD", text) if not unicodedata.combining(ch))


# One pattern per alias. A country name ends at any character that is not a
# letter or digit, so "passport (Bangladesh)" and "in Austria: 2008" are found.
# Aliases are accent-folded because the text they are matched against is.
_COUNTRY_SCAN_RE = tuple(
    (re.compile(r"(?<![a-z0-9])" + re.escape(_fold(alias)) + r"(?![a-z0-9])"), canon)
    for alias, canon in _COUNTRY_SCAN
)

# =============================================================================
# Dates
# =============================================================================

class PDate:
    """Partial date: year required for truthiness; month/day optional."""
    __slots__ = ("year", "month", "day")

    def __init__(self, year, month=None, day=None):
        self.year = int(year) if year else None
        self.month = int(month) if month else None
        self.day = int(day) if day else None
        if self.month is not None and not (1 <= self.month <= 12):
            self.month, self.day = None, None
        if self.day is not None and not (1 <= self.day <= 31):
            self.day = None

    def __bool__(self):
        return self.year is not None

    def __eq__(self, other):
        return isinstance(other, PDate) and (self.year, self.month, self.day) == (other.year, other.month, other.day)

    def __hash__(self):
        return hash((self.year, self.month, self.day))

    def iso(self):
        if not self:
            return None
        if self.month is None:
            return f"{self.year:04d}"
        if self.day is None:
            return f"{self.year:04d}-{self.month:02d}"
        return f"{self.year:04d}-{self.month:02d}-{self.day:02d}"

    def date_min(self):
        if not self:
            return None
        return date(self.year, self.month or 1, self.day or 1)

    def date_max(self):
        if not self:
            return None
        if self.month is None:
            return date(self.year, 12, 31)
        if self.day is None:
            if self.month == 12:
                return date(self.year, 12, 31)
            return date(self.year, self.month + 1, 1) - timedelta(days=1)
        try:
            return date(self.year, self.month, self.day)
        except ValueError:
            return date(self.year, self.month, 1)

    def has_full(self):
        return bool(self.year and self.month and self.day)

    def equal_known(self, other):
        """True when every part both give is equal (principle 2 / 7)."""
        if not self or not other:
            return False
        if self.year != other.year:
            return False
        if self.month and other.month and self.month != other.month:
            return False
        if self.day and other.day and self.day != other.day:
            return False
        return True

    def contradicts(self, other, year_tol=DOB_YEAR_TOLERANCE):
        """POLICY: year more than 1 outside, or same year with different month/day."""
        if not self or not other:
            return False
        if abs(self.year - other.year) > year_tol:
            return True
        if self.year == other.year and self.month and other.month:
            if self.month != other.month:
                return True
            if self.day and other.day and self.day != other.day:
                return True
        return False

    def agrees(self, other):
        """Year is one of the hit years and every shared part is equal."""
        return self.equal_known(other)


_MONTH_ALT = r"(?:January|February|March|April|May|June|July|August|September|October|November|December|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)"


def _normalise_date_text(text):
    """Rewrite other common date spellings into forms the matchers already read.

    5th March 2001 / March 5th, 2001 -> ordinals dropped; 05-Mar-2001 / 05.Mar.2001 ->
    "05 Mar 2001"; 2001/03/05 and 2001.03.05 -> ISO; 05.03.2001 / 05-03-2001 -> 05/03/2001;
    "YYYY-00-00" -> year; "circa 1960" / "c. 1960" / "about 1960" -> year. Two-digit
    years are left alone (unreadable stays unknown).
    """
    if not text:
        return text
    t = re.sub(r"(?<=\d)(?:st|nd|rd|th)\b", "", text, flags=re.I)
    t = re.sub(r"\b(\d{1,2})[-./ ](" + _MONTH_ALT + r")\.?[-./ ](\d{4})\b", r"\1 \2 \3", t, flags=re.I)
    t = re.sub(r"\b(" + _MONTH_ALT + r")\.(?=\s)", r"\1", t, flags=re.I)
    t = re.sub(r"\b(\d{4})[/.](\d{1,2})[/.](\d{1,2})\b", r"\1-\2-\3", t)
    t = re.sub(r"\b(\d{1,2})[.-](\d{1,2})[.-](\d{4})\b", r"\1/\2/\3", t)
    t = re.sub(r"\b(\d{4})-00(?:-00)?\b", r"\1", t)
    t = re.sub(r"\b(\d{4}-\d{2})-00\b", r"\1", t)
    t = re.sub(r"^(?:circa|ca\.?|c\.|about|approx\.?|approximately|around)\s*(\d{4})$", r"\1", t.strip(), flags=re.I)
    return t


def parse_date(val):
    if val is None or val == "":
        return None
    if isinstance(val, PDate):
        return val if val else None
    if isinstance(val, date):
        return PDate(val.year, val.month, val.day)
    if isinstance(val, (int, float)):
        y = int(val)
        return PDate(y) if 1800 <= y <= 2100 else None
    text = _normalise_date_text(str(val).strip())
    if not text or text.lower() in PLACEHOLDERS:
        return None
    m = re.fullmatch(r"(\d{4})[-.](\d{1,2})[-.](\d{1,2})", text) or re.fullmatch(r"(\d{4})(\d{2})(\d{2})", text)
    if m:
        y, mo, d = int(m.group(1)), int(m.group(2)), int(m.group(3))
        if 1800 <= y <= 2100 and 1 <= mo <= 12 and 1 <= d <= 31:
            return PDate(y, mo, d)
        return None
    m = re.fullmatch(r"(\d{4})-(\d{1,2})", text)
    if m:
        y, mo = int(m.group(1)), int(m.group(2))
        if 1800 <= y <= 2100 and 1 <= mo <= 12:
            return PDate(y, mo)
        return None
    m = re.fullmatch(r"(\d{4})", text)
    if m:
        y = int(m.group(1))
        return PDate(y) if 1800 <= y <= 2100 else None
    # DD/MM/YYYY (UK bank: prefer DMY when ambiguous)
    m = re.fullmatch(r"(\d{1,2})/(\d{1,2})/(\d{4})", text)
    if m:
        a, b, y = int(m.group(1)), int(m.group(2)), int(m.group(3))
        if a > 12:
            return PDate(y, b, a)
        if b > 12:
            return PDate(y, a, b)
        return PDate(y, b, a)  # DMY
    # Month-name forms
    m = re.fullmatch(
        r"(?:(\d{1,2})\s+)?([A-Za-z]{3,9})\.?(?:\s+(\d{1,2}))?,?\s+(\d{4})",
        text,
    )
    if m:
        mon = MONTHS.get(m.group(2).lower())
        y = int(m.group(4))
        if mon and 1800 <= y <= 2100:
            day = m.group(1) or m.group(3)
            return PDate(y, mon, int(day) if day else None)
    # loose search inside a longer string
    m = re.search(r"(\d{4}-\d{2}-\d{2})", text)
    if m:
        return parse_date(m.group(1))
    m = re.search(
        r"(?:(\d{1,2})\s+)?([A-Za-z]{3,9})\.?(?:\s+(\d{1,2}))?,?\s+(\d{4})",
        text,
    )
    if m and MONTHS.get((m.group(2) or "").lower()):
        return parse_date(m.group(0))
    return None


# =============================================================================
# Text / country helpers
# =============================================================================

def strip_accents(text):
    if text is None:
        return ""
    return _fold(text)


def norm_space(text):
    return re.sub(r"\s+", " ", (text or "").strip())


def country_of(val):
    """Map a code, adjective, or name to a canonical country; None if not a country."""
    if val is None or val == "":
        return None
    if isinstance(val, (list, tuple)):
        # shouldn't happen at this layer
        return None
    text = strip_accents(str(val)).strip()
    text = re.sub(r"\[.*?\]", "", text).replace("\u2019", "'").replace("\u2018", "'").strip(" ,;.")
    if not text:
        return None
    low = re.sub(r"\s+", " ", text.lower())
    if low.replace(".", "") in {"us", "usa", "uk", "uae"} and "." in low:
        low = low.replace(".", "")
    if low in NOT_COUNTRIES or low in PLACEHOLDERS:
        return None
    if low in COUNTRY_MAP:
        return COUNTRY_MAP[low]
    # "Sassari, Sassari, Italy" / "American" already handled; try last comma part
    if "," in text:
        for part in reversed([p.strip() for p in text.split(",")]):
            c = country_of(part)
            if c:
                return c
    # trailing "the United States"
    if low.startswith("the ") and low[4:] in COUNTRY_MAP:
        return COUNTRY_MAP[low[4:]]
    # formal names: "Federal Republic of Germany", "Kingdom of Spain", "Islamic Republic of Iran"
    fm = re.fullmatch(r"(?:the\s+)?(?:(?:federal|islamic|democratic|people's|socialist|united|arab|"
                      r"plurinational|bolivarian|federative|hashemite|commonwealth|independent)\s+)*"
                      r"(?:republic|kingdom|state|states|federation|principality|grand duchy|sultanate|emirate)"
                      r"\s+of\s+(?:the\s+)?(.+)", low)
    if fm and fm.group(1) in COUNTRY_MAP:
        return COUNTRY_MAP[fm.group(1)]
    return None


def countries_from_values(values):
    out, seen = [], set()
    for val in values:
        if val is None or val == "":
            continue
        if isinstance(val, (list, tuple)):
            for item in val:
                c = country_of(item) if not (isinstance(item, str) and "," in item) else (
                    country_of(item)
                )
                if c and c not in seen:
                    seen.add(c)
                    out.append(c)
            continue
        c = country_of(val)
        if c and c not in seen:
            seen.add(c)
            out.append(c)
    return out


def unrecognised_countries(values):
    """Country values that are given but map to no known country.

    "International", "Europe" and placeholders are not countries, so they are not
    unrecognised. A value we cannot read might be the country both sides share,
    so a location contradiction is not trusted while one exists.
    """
    out = []
    for val in values:
        items = val if isinstance(val, (list, tuple)) else [val]
        for item in items:
            if item is None or item == "":
                continue
            text = re.sub(r"\[.*?\]", "", strip_accents(str(item))).strip(" ,;.")
            low = re.sub(r"\s+", " ", text.lower())
            if not low or low in NOT_COUNTRIES or low in PLACEHOLDERS:
                continue
            if country_of(text) is None and text not in out:
                out.append(text)
    return out


def countries_in_text(text):
    """Find canonical countries mentioned in free text (longest aliases first)."""
    if not text:
        return []
    low = " " + re.sub(r"\s+", " ", strip_accents(text).lower()) + " "
    found, seen = [], set()
    for pattern, canon in _COUNTRY_SCAN_RE:
        if canon not in seen and pattern.search(low):
            seen.add(canon)
            found.append(canon)
    return found


_US_STATES = frozenset("AL AK AZ AR CA CO CT DE FL GA HI ID IL IN IA KS KY LA ME MD MA MI MN MS MO MT NE NV NH NJ NM NY NC ND OH OK OR PA RI SC SD TN TX UT VT VA WA WV WI WY DC".split())


def last_address_country(addr):
    if not addr:
        return None
    text = re.sub(r"\[.*?\]", "", str(addr)).strip(" ,;.")
    if not text:
        return None
    # last comma-separated token, skipping postcodes
    parts = [p.strip() for p in text.split(",") if p.strip()]
    if len(parts) >= 2 and re.fullmatch(r"[A-Z]{2}(?:\s+\d{5}(?:-\d{4})?)?", parts[-1]) and parts[-1][:2] in _US_STATES:
        return "United States"   # "Springfield, IL" is Illinois, not Israel
    if len(parts) >= 2 and parts[-1].lower() == "georgia":
        return None              # US state or the country: unknown, so never a contradiction
    for part in reversed(parts):
        c = country_of(part)
        if c:
            return c
        # "A1C 1K4" etc
        if re.fullmatch(r"[A-Z0-9][A-Z0-9 ]{1,8}", part, re.I):
            continue
    return country_of(text)


def normalise_phone(val):
    if not val:
        return ""
    return re.sub(r"[^\d+]", "", str(val))


def normalise_docno(val):
    if not val:
        return ""
    return re.sub(r"\s+", "", str(val)).upper()


# =============================================================================
# Names — POLICY.md principle 8
# =============================================================================

def levenshtein(a, b):
    if a == b:
        return 0
    if not a:
        return len(b)
    if not b:
        return len(a)
    if len(a) < len(b):
        a, b = b, a
    prev = list(range(len(b) + 1))
    for i, ca in enumerate(a, 1):
        curr = [i]
        for j, cb in enumerate(b, 1):
            curr.append(min(curr[j - 1] + 1, prev[j] + 1, prev[j - 1] + (ca != cb)))
        prev = curr
    return prev[-1]


def is_placeholder_token(tok):
    if not tok:
        return True
    if tok in PLACEHOLDERS:
        return True
    # digits and the like
    if re.fullmatch(r"\d+", tok):
        return True
    if re.fullmatch(r"[x]+", tok):
        return True
    return False


class NameSystem:
    def __init__(self, groups, legal_forms):
        # part -> list of group ids it belongs to (not transitive across groups)
        self.group_ids = defaultdict(set)
        for i, group in enumerate(groups or []):
            for member in group:
                tok = self._raw_token(member)
                if tok:
                    self.group_ids[tok].add(i)
        self.legal_forms = set()
        for form in legal_forms or []:
            tok = self._raw_token(form)
            if tok:
                self.legal_forms.add(tok)

    @staticmethod
    def _raw_token(text):
        t = strip_accents(str(text)).lower()
        t = re.sub(r"[^\w]+", " ", t)
        return re.sub(r"\s+", " ", t).strip()

    def parts(self, name, company=False):
        """Distinct real name parts, initials and placeholders dropped."""
        if not name:
            return []
        text = str(name)
        text = re.sub(r"\([^)]*\)", " ", text)
        text = re.sub(r"\[[^\]]*\]", " ", text)
        text = strip_accents(text).lower()
        text = text.replace("&", " and ")
        text = re.sub(r"[^\w\s]", " ", text)
        raw = [t for t in text.split() if t]
        out, seen = [], set()
        for t in raw:
            if len(t) == 1:  # initial, not a part
                continue
            if is_placeholder_token(t):
                continue
            if company and t in self.legal_forms:
                continue
            if t in seen:
                continue
            seen.add(t)
            out.append(t)
        return out

    def parts_match(self, a, b):
        if not a or not b:
            return False
        if a == b:
            return True
        ga, gb = self.group_ids.get(a), self.group_ids.get(b)
        if ga and gb and (ga & gb):
            return True
        # typo: shorter length decides; <4 must be identical; 4-6: 1 edit; else 2
        shorter = a if len(a) <= len(b) else b
        n = len(shorter)
        if n < 4:
            return False
        allowed = 1 if n <= 6 else 2
        return levenshtein(a, b) <= allowed

    def names_agree(self, name_a, name_b, company=False):
        """At least two parts match, or every part of the shorter name matches.

        Together/apart: Abdulsalam matches Abdul Salam, one part covering both.
        """
        pa = self.parts(name_a, company=company)
        pb = self.parts(name_b, company=company)
        if not pa or not pb:
            return False
        matched = self._match_count(pa, pb)
        if matched >= 2:
            return True
        shorter = pa if len(pa) <= len(pb) else pb
        # "every part of the shorter name matches"
        return matched >= len(shorter) and matched >= 1

    def _match_count(self, pa, pb):
        """Greedy alignment, including concatenated adjacent parts."""
        used = [False] * len(pb)
        n = 0
        i = 0
        while i < len(pa):
            found = False
            # prefer two-to-one / one-to-two before single, longest first
            # one part of A equals two adjacent of B
            if i < len(pa):
                for j in range(len(pb) - 1):
                    if used[j] or used[j + 1]:
                        continue
                    if self.parts_match(pa[i], pb[j] + pb[j + 1]) or pa[i] == pb[j] + pb[j + 1]:
                        used[j] = used[j + 1] = True
                        n += 1  # one part covering both
                        found = True
                        break
            if found:
                i += 1
                continue
            # two adjacent of A equal one of B
            if i < len(pa) - 1:
                concat = pa[i] + pa[i + 1]
                for j, u in enumerate(pb):
                    if used[j]:
                        continue
                    if self.parts_match(concat, u) or concat == u:
                        used[j] = True
                        n += 1
                        found = True
                        i += 2
                        break
                if found:
                    continue
            for j, u in enumerate(pb):
                if used[j]:
                    continue
                if self.parts_match(pa[i], u):
                    used[j] = True
                    n += 1
                    found = True
                    break
            i += 1
        return n

    def any_agree(self, names_a, names_b, company=False):
        for a in names_a:
            for b in names_b:
                if self.names_agree(a, b, company=company):
                    return True
        return False


# Jaro-Winkler is logged only, never used in a decision (POLICY.md principle 8).
def jaro(s1, s2):
    if s1 == s2:
        return 1.0
    if not s1 or not s2:
        return 0.0
    len1, len2 = len(s1), len(s2)
    window = max(0, max(len1, len2) // 2 - 1)
    m1, m2 = [False] * len1, [False] * len2
    matches = 0
    for i, ch in enumerate(s1):
        start, end = max(0, i - window), min(i + window + 1, len2)
        for j in range(start, end):
            if m2[j] or ch != s2[j]:
                continue
            m1[i] = m2[j] = True
            matches += 1
            break
    if matches == 0:
        return 0.0
    t = k = 0
    for i in range(len1):
        if not m1[i]:
            continue
        while not m2[k]:
            k += 1
        if s1[i] != s2[k]:
            t += 1
        k += 1
    return (matches / len1 + matches / len2 + (matches - t / 2) / matches) / 3.0


def jaro_winkler(s1, s2):
    j = jaro(s1, s2)
    pref = 0
    for a, b in zip(s1, s2):
        if a != b or pref >= 4:
            break
        pref += 1
    return j + pref * 0.1 * (1.0 - j)


def jw_best(names_a, names_b, ns):
    best = 0.0
    for a in names_a:
        pa = " ".join(ns.parts(a, company=False) or [strip_accents(str(a)).lower()])
        sa = " ".join(sorted((ns.parts(a) or [pa])))
        for b in names_b:
            pb = " ".join(ns.parts(b, company=False) or [strip_accents(str(b)).lower()])
            sb = " ".join(sorted((ns.parts(b) or [pb])))
            best = max(best, jaro_winkler(pa, pb), jaro_winkler(sa, sb))
    return best


def linkage_score(levels, company=False):
    """Fixed m/u-style weights used only to gate confirmations.

    This is a small, local version of Splink's comparison-level approach. The
    policy, rather than this score, remains the only source of a clearance.
    """
    weights = {"name": 4.0, "dob": 6.0, "country": 2.0, "entity_type": 1.0}
    total = sum(weights[field] for field, level in levels.items() if level == "agree")
    # Policy requires name + country for a company; people need name + DOB.
    # These thresholds cannot authorise a DIFFERENT_ENTITY result.
    return total, (6.0 if company else 10.0)

# =============================================================================
# IO
# =============================================================================

def _decode_line(raw):
    """Decode one JSONL line, tolerating BOM, Latin-1 leftovers and bad bytes."""
    if raw.startswith(b"\xef\xbb\xbf"):
        raw = raw[3:]
    for enc in ("utf-8", "utf-8-sig"):
        try:
            return raw.decode(enc)
        except UnicodeDecodeError:
            continue
    return raw.decode("utf-8", errors="replace")


def read_jsonl(path):
    """Read a JSONL file without crashing the run on a bad line or encoding.

    Missing files yield an empty list (optional inputs). Blank lines, a UTF-8 BOM,
    CRLF, unknown extra fields, and a single malformed or non-UTF-8 line are skipped
    rather than aborting the process. Non-object rows are ignored.
    """
    rows = []
    path = Path(path)
    if not path.exists() or not path.is_file():
        return rows
    try:
        raw = path.read_bytes()
    except OSError:
        return rows
    if raw.startswith(b"\xef\xbb\xbf"):
        raw = raw[3:]
    for line in raw.splitlines():
        if not line.strip():
            continue
        text = _decode_line(line).strip()
        if not text:
            continue
        try:
            row = json.loads(text)
        except (json.JSONDecodeError, ValueError, TypeError):
            continue
        if isinstance(row, dict):
            rows.append(row)
    return rows


def read_json(path):
    path = Path(path)
    if not path.exists() or not path.is_file():
        return None
    try:
        raw = path.read_bytes()
    except OSError:
        return None
    if raw.startswith(b"\xef\xbb\xbf"):
        raw = raw[3:]
    for enc in ("utf-8", "utf-8-sig"):
        try:
            data = json.loads(raw.decode(enc))
            break
        except (UnicodeDecodeError, json.JSONDecodeError, ValueError):
            data = None
    else:
        try:
            data = json.loads(raw.decode("utf-8", errors="replace"))
        except (json.JSONDecodeError, ValueError):
            return None
    return data if isinstance(data, (dict, list)) else None


def as_list(val):
    """Coerce a field that should be a list (dobs, countries, aliases, addresses)."""
    if val is None or val == "":
        return []
    if isinstance(val, list):
        return val
    if isinstance(val, tuple):
        return list(val)
    if isinstance(val, dict):
        return list(val.values()) if val else []
    return [val]


def as_text(val):
    if val is None or val == "":
        return ""
    if isinstance(val, (list, tuple, dict)):
        return ""
    return str(val)


def fallback_prediction(hit, alert=None):
    """A valid REVIEW line so a crash on one hit cannot zero the run."""
    hit = hit if isinstance(hit, dict) else {}
    alert = alert if isinstance(alert, dict) else {}
    return {
        "hit_id": hit.get("hit_id"),
        "alert_id": hit.get("alert_id") or alert.get("alert_id"),
        "decision": "REVIEW",
        "reason_code": "INSUFFICIENT_DATA",
        "customer_record_id": None,
        "reason": (
            "The system could not finish the comparison for this hit because a record "
            "was missing or unreadable. The hit is sent to review so it is neither "
            "cleared nor confirmed."
        ),
        "evidence": [],
    }


def _sentences(text):
    """Split a reason into sentences, keeping Inc./Ltd./(MTA). with their clause."""
    text = (text or "").strip()
    if not text:
        return []
    abbrev = {
        "inc", "ltd", "llc", "corp", "co", "plc", "sa", "s.a", "s.l", "jr", "sr",
        "mr", "mrs", "ms", "dr", "st", "u.s", "u.k", "d.o.b", "no", "nos",
    }
    parts, buf = [], []
    i, n = 0, len(text)
    while i < n:
        ch = text[i]
        buf.append(ch)
        if ch in ".!?":
            nxt = text[i + 1] if i + 1 < n else ""
            if ch == "." and nxt and not nxt.isspace() and nxt not in "\"')]}":
                i += 1
                continue
            word = "".join(buf).rstrip()
            token = word.split()[-1].rstrip(".)").lower() if word.split() else ""
            # "Inc." or "U.S." or a trailing initial "A."
            j = i + 1
            while j < n and text[j].isspace():
                j += 1
            nxt_ns = text[j] if j < n else ""
            # "Inc." / "Ltd." / initial "A." are abbreviations only when not
            # followed by a new capitalised sentence.
            if ch == "." and (token in abbrev or (len(token) == 1 and token.isalpha())):
                if not (nxt_ns.isalpha() and nxt_ns.isupper()):
                    i += 1
                    continue
            # Lookahead: next clause starting with "(" is a leftover acronym
            if nxt_ns == "(":
                i += 1
                continue
            parts.append("".join(buf).strip())
            buf = []
            i += 1
            while i < n and text[i].isspace():
                i += 1
            continue
        i += 1
    tail = "".join(buf).strip()
    if tail:
        parts.append(tail)
    return [p for p in parts if p]


def ident_cite(ident):
    if not ident:
        return ""
    iid = ident.get("check_id") or ident.get("note_id") or ""
    return f" ({iid})" if iid else ""


# =============================================================================
# KYC-in-notes and lived-in countries
# =============================================================================

KYC_SUCCESS_RE = re.compile(
    r"\b(?:verified|validated|confirmed|successfully|successful|cleared|completed|processed|"
    r"check complete|identity verification)\b",
    re.I,
)
# A KYC-channel note counts as a passed check unless it records a failure, so
# this list is the only thing standing between a failed check and a "verified"
# name or date of birth. A failed check read as passed can clear a real match
# (NAME_MISMATCH_VERIFIED / DOB_MISMATCH), so the list is deliberately wide.
# Words that also occur in passed notes ("expiry 2031", "no signs of fraud",
# "no discrepancies") are only matched in phrases that state a failure.
KYC_FAIL_RE = re.compile(
    r"\b(?:"
    # outright failure
    r"reject(?:ed|ion|s)?|fail(?:ed|s|ure|ing)?|declin(?:ed|e|es)|unsuccessful(?:ly)?|"
    r"den(?:ied|ial)|refus(?:ed|al)|invalid(?:ated)?|not (?:approved|verified|passed|valid|accepted|"
    r"successful|completed|confirmed|cleared)|"
    r"(?:did not|didn't|does not|doesn't|do not|don't|was not|wasn't|were not|weren't|could not|"
    r"couldn't|cannot|can't|unable to|impossible to) (?:\w+ ){0,2}(?:pass|match|verif\w*|confirm\w*|"
    r"approv\w*|complet\w*|accept\w*|validat\w*|read|process\w*|succeed\w*|authenticat\w*)|"
    r"could not|unable to|mismatch(?:ed|es)?|no match|unverified|"
    # expiry, stated as a failure
    r"expired|lapsed|out of date|no longer valid|past (?:its |the )?expiry|expiry date (?:has )?passed|"
    # not finished yet
    r"pending|inconclusive|on hold|awaiting|in progress|incomplete|not yet|outstanding|"
    r"abandoned|aborted|cancel(?:l)?ed|withdrawn|timed out|suspended|"
    # sent back or escalated
    r"resubmi(?:t|ssion|tted)|re-submi(?:t|ssion|tted)|(?:requires?|needs?|sent for|referred for|"
    r"escalated (?:for|to)|flagged for) (?:\w+ ){0,2}review|under review|flagged|escalated|"
    # unusable document
    r"unreadable|illegible|blurr(?:y|ed)|"
    # suspected forgery
    r"suspected fraud|fraudulent|forged|forgery|tampered|counterfeit|altered document"
    r")\b",
    re.I,
)
LIVED_RE = re.compile(
    r"\b(?:liv(?:e|es|ed|ing)|residenc(?:y|e|es)|resid(?:e|es|ed|ing|ent|ents)|worked|working|"
    r"employ(?:ed|ment)|based in|household|home and|job in|settled|relocated|moved|"
    r"stayed|staying|dwelt|domiciled|home in|lived in)\b",
    re.I,
)

# ALL-CAPS name of 2+ tokens
_UC = r"[^\W\da-z_]"
CAPS_NAME_RE = re.compile(
    r"(?<![\w])((?:" + _UC + r"{2,}|0{3,}|N/A)(?:(?:\s+|\s*,\s*)(?:" + _UC + r"|0{3,}|N/A)(?:" + _UC + r"|['./-])*){1,5})(?![\w])"
)
DOB_LABEL_RE = re.compile(
    r"(?:DOB|date of birth|birth date|born)\s*(?:on document\s*)?(?:is\s*|of\s*|:?\s*)"
    r"(\d{4}-\d{2}-\d{2}|\d{1,2}/\d{1,2}/\d{4}|"
    r"(?:(?:\d{1,2}\s+)?(?:Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|"
    r"Jul(?:y)?|Aug(?:ust)?|Sep(?:t(?:ember)?)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)"
    r"\.?(?:\s+\d{1,2})?,?\s+\d{4}))",
    re.I,
)
PAREN_DOB_RE = re.compile(
    r"\((\d{1,2}/\d{1,2}/\d{4}|\d{4}-\d{2}-\d{2}|"
    r"(?:January|February|March|April|May|June|July|August|September|October|November|December)"
    r"\s+\d{1,2},\s+\d{4})\)",
    re.I,
)
DOC_COUNTRY_RE = re.compile(
    r"(?:from(?: the)?|issued in|originating from(?: the)?|passport(?: from(?: the)?)?|"
    r"national ID(?: from(?: the)?)?|driving licence(?: from(?: the)?)?|"
    r"documentation is from(?: the)?|for(?: the)?)\s+"
    r"([A-Z][A-Za-z]*(?:\s+[A-Z][A-Za-z]*){0,3})",
    re.I,
)



_MON='(?:January|February|March|April|May|June|July|August|September|October|November|December|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)'
ANY_DATE_RE = re.compile(
    r"\d{4}-\d{2}-\d{2}|\d{1,2}/\d{1,2}/\d{4}|" + _MON + r"\.?\s+\d{1,2},?\s+\d{4}|\d{1,2}\s+" + _MON + r"\.?,?\s+\d{4}", re.I)
BIRTH_KW_RE = re.compile(r"\b(?:DOB|D\.O\.B\.?|date of birth|birth date|birthdate|birthday|born|birth)\b", re.I)

def dob_from_note_text(text):
    """Birth date = the date closest (in characters) to a birth keyword."""
    dates = [(m.start(), m.end(), m.group(0)) for m in ANY_DATE_RE.finditer(text)
             if not re.search(r"(?<!born )(?<!born)\bon\s+$", text[max(0, m.start() - 8):m.start()], re.I)
             or re.search(r"\b(?:DOB|birth)\b\s*(?:\w+\s+){0,2}on\s+$", text[max(0, m.start() - 30):m.start()], re.I)]
    kws = [(m.start(), m.end()) for m in BIRTH_KW_RE.finditer(text)]
    best = None
    for ds, de, raw in dates:
        for ks, ke in kws:
            gap = ks - de if ks >= de else (ds - ke if ds >= ke else 0)
            if gap <= 40 and (best is None or gap < best[0]):
                best = (gap, raw)
    if best:
        return parse_date(best[1])
    # no keyword: the one date not introduced by "on" (that is the check date)
    free = [raw for ds, de, raw in dates]
    if len(free) == 1:
        return parse_date(free[0])
    ym = re.search(r"(?:DOB|date of birth|birth date|born)(?:\s+(?:is|of|as|in|on))?\s*:?\s*((?:19|20)\d{2})\b(?![-/])", text, re.I)
    if ym:
        return parse_date(ym.group(1))
    pm = re.findall(r"\(\s*(" + ANY_DATE_RE.pattern + r")\s*\)", text, re.I)
    if len(pm) == 1:
        return parse_date(pm[0] if isinstance(pm[0], str) else pm[0][0])
    return None

def parse_kyc_note(note):
    """Return dict or None for an approved identity check written only in a note."""
    text = _normalise_date_text(note.get("text") or "")
        # A note in the KYC channel records a completed check; providers word a pass
    # many ways ("passed", "approved", "matches", "finalized"), but a failure always
    # says so. Outside the KYC channel, require an explicit success word.
    if not text or KYC_FAIL_RE.search(text):
        return None
    if (note.get("channel") or "").lower() != "kyc" and not KYC_SUCCESS_RE.search(text):
        return None
    dob = None
    m = DOB_LABEL_RE.search(text)
    if m:
        dob = parse_date(m.group(1))
    if not dob:
        m = PAREN_DOB_RE.search(text)
        if m:
            dob = parse_date(m.group(1))
    if not dob:
        dob = dob_from_note_text(text)
    name = None
    # Prefer a caps name near DOB / verification words
    caps = list(CAPS_NAME_RE.finditer(text))
    skip = {
        "DOB", "ID", "THE", "FOR", "AND", "FROM", "USING", "WITH", "DATE", "BIRTH",
        "NATIONAL", "PASSPORT", "DRIVING", "LICENCE", "LICENSE", "DOCUMENT",
        "PERSONA", "SUMSUB", "ONFIDO", "VERIFF", "UNITED", "STATES", "KINGDOM",
    }
    for m in caps:
        cand = m.group(1).strip(" ,")
        toks = [t for t in re.split(r"[\s,]+", cand) if t]
        if len(toks) < 2:
            continue
        if all(t.upper() in skip or country_of(t) for t in toks):
            continue
        name = re.sub(r"[,;]\s*(?:DOB|D\.O\.B\.?|born|birth).*", "", cand, flags=re.I).strip(" ,;.")
        if len(re.split(r"[\s,]+", name)) >= 2:
            break
        name = None
    # document country
    doc_country = None
    # try explicit phrases first
    for m in DOC_COUNTRY_RE.finditer(text):
        c = country_of(m.group(1))
        if c:
            doc_country = c
            break
    if not doc_country:
        cs = countries_in_text(text)
        if len(cs) == 1:
            doc_country = cs[0]
    checked = parse_date(note.get("created_at"))
    m = re.search(r"\b(20\d{2}-\d{2}-\d{2})\b", text)
    if m:
        checked = parse_date(m.group(1)) or checked
    # A birth date equal to (or after) the check date is the check date misread, not a DOB.
    if dob and checked and (dob == checked or (dob.date_min() and checked.date_max() and dob.date_min() > checked.date_max())):
        dob = None
    created = parse_date(note.get("created_at"))
    if dob and created and dob == created:
        dob = None
    if not name and not dob:
        return None
    return {
        "source": "note",
        "note_id": note.get("note_id"),
        "check_id": note.get("note_id"),
        "verified_name": name,
        "verified_dob": dob,
        "document_country": doc_country,
        "document_number": None,
        "checked_at": checked,
        "result": "approved",
    }


# =============================================================================
# Bank indexes
# =============================================================================

class Bank:
    pass


def load_bank(data_folder):
    root = Path(data_folder)
    # Accept either the folder itself (alerts.jsonl next to POLICY.md)
    # or a parent that contains dev/.
    if not (root / "alerts.jsonl").exists() and (root / "dev" / "alerts.jsonl").exists():
        root = root / "dev"
    b = Bank()
    b.root = root
    b.alerts = read_jsonl(root / "alerts.jsonl")
    b.hits = read_jsonl(root / "hits.jsonl")
    b.customers = read_jsonl(root / "customers.jsonl")
    b.accounts = read_jsonl(root / "accounts.jsonl")
    b.onboarding = read_jsonl(root / "onboarding.jsonl")
    b.kyc_checks = read_jsonl(root / "kyc_checks.jsonl")
    b.notes = read_jsonl(root / "notes.jsonl")
    b.search_results = read_jsonl(root / "search_results.jsonl")
    variants = read_json(root / "name_variants.json") or {}
    b.ns = NameSystem(variants.get("groups") or [], variants.get("company_legal_forms") or [])

    # Canonical entity types ("Organisation", "person" ...) and drop rows that are not objects.
    for rows in (b.alerts, b.hits, b.customers, b.accounts, b.onboarding, b.kyc_checks, b.notes, b.search_results):
        rows[:] = [r for r in rows if isinstance(r, dict)]
    for h in b.hits:
        if "entity_type" in h:
            h["entity_type"] = canon_etype(h.get("entity_type"))
    for c in b.customers:
        if "entity_type" in c:
            c["entity_type"] = canon_etype(c.get("entity_type"))
    for a in b.alerts:
        if isinstance(a.get("customer"), dict) and "entity_type" in a["customer"]:
            a["customer"]["entity_type"] = canon_etype(a["customer"].get("entity_type"))
    b.alerts = [a for a in b.alerts if a.get("alert_id")]
    b.hits = [h for h in b.hits if h.get("hit_id")]
    b.alerts_by_id = {a["alert_id"]: a for a in b.alerts}
    b.hits_by_id = {h["hit_id"]: h for h in b.hits}
    b.customers_by_id = {c["record_id"]: c for c in b.customers if c.get("record_id")}

    b.accounts_by_id = defaultdict(list)
    b.accounts_by_login = defaultdict(list)
    b.accounts_by_customer = defaultdict(list)
    for a in b.accounts:
        acc_id = a.get("account_id")
        if acc_id:
            b.accounts_by_id[acc_id].append(a)
        login = a.get("login_handle")
        if login is not None and login != "":
            b.accounts_by_login[login].append(a)
            b.accounts_by_login[str(login).lower()].append(a)
        cid = a.get("customer_id")
        if cid:
            b.accounts_by_customer[cid].append(a)

    b.onboarding_by_account = defaultdict(list)
    b.onboarding_by_customer = defaultdict(list)
    b.onboarding_by_applicant = defaultdict(list)
    for o in b.onboarding:
        if o.get("account_id"):
            b.onboarding_by_account[o["account_id"]].append(o)
        if o.get("customer_id"):
            b.onboarding_by_customer[o["customer_id"]].append(o)
        if o.get("kyc_applicant_id"):
            b.onboarding_by_applicant[o["kyc_applicant_id"]].append(o)

    b.kyc_by_applicant = defaultdict(list)
    b.kyc_approved_by_doc = defaultdict(list)
    for k in b.kyc_checks:
        app = k.get("applicant_id")
        if app:
            b.kyc_by_applicant[app].append(k)
        if as_text(k.get("result")).lower() == "approved":
            doc = normalise_docno(k.get("document_number"))
            if doc:
                b.kyc_approved_by_doc[doc].append(k)

    b.customers_by_email = defaultdict(list)
    b.customers_by_phone = defaultdict(list)
    for c in b.customers:
        em = c.get("email")
        if isinstance(em, str) and em:
            b.customers_by_email[em.lower()].append(c)
        ph = normalise_phone(c.get("phone"))
        if ph:
            b.customers_by_phone[ph].append(c)

    b.notes_by_email = defaultdict(list)
    for n in b.notes:
        em = n.get("requester_email")
        if isinstance(em, str) and em:
            b.notes_by_email[em.lower()].append(n)
        elif em:
            b.notes_by_email[str(em).lower()].append(n)

    b.search_by_query = defaultdict(list)
    b.search_by_sorted = defaultdict(list)
    for s in b.search_results:
        q = strip_accents(s.get("query") or "").lower()
        q = re.sub(r"[^\w\s]", " ", q)
        q = re.sub(r"\s+", " ", q).strip()
        if q:
            b.search_by_query[q].append(s)
            key = " ".join(sorted(q.split()))
            b.search_by_sorted[key].append(s)

    # Global same-person clusters (principle 3), union-find
    parent = {c["record_id"]: c["record_id"] for c in b.customers if c.get("record_id")}

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            if ra < rb:
                parent[rb] = ra
            else:
                parent[ra] = rb

    # phone AND same full DOB
    # group customers by (phone, full iso dob)
    by_phone_dob = defaultdict(list)
    for c in b.customers:
        ph = normalise_phone(c.get("phone"))
        dob = parse_date(c.get("dob"))
        if ph and dob and dob.has_full():
            by_phone_dob[(ph, dob.iso())].append(c["record_id"])
    for ids in by_phone_dob.values():
        for other in ids[1:]:
            union(ids[0], other)

    # same document number on approved checks, transitively via their customers
    def customers_for_check(k):
        ids = []
        for o in b.onboarding_by_applicant.get(k["applicant_id"], []):
            ids.append(o["customer_id"])
        return ids

    for doc, checks in b.kyc_approved_by_doc.items():
        recs = []
        for k in checks:
            recs.extend(customers_for_check(k))
        recs = [r for r in recs if r in parent]
        if len(recs) >= 2:
            for other in recs[1:]:
                union(recs[0], other)

    # freeze
    clusters = defaultdict(list)
    for cid in parent:
        clusters[find(cid)].append(cid)
    b.cluster_of = {cid: find(cid) for cid in parent}
    b.cluster_members = {k: sorted(v) for k, v in clusters.items()}

    # approved kyc (provider) per customer
    b.approved_kyc_for = defaultdict(list)
    for o in b.onboarding:
        for k in b.kyc_by_applicant.get(o["kyc_applicant_id"], []):
            if as_text(k.get("result")).lower() == "approved" and o.get("customer_id"):
                b.approved_kyc_for[o["customer_id"]].append(k)

    # dob index for unlinked search
    b.by_dob_year = defaultdict(list)
    b.by_country = defaultdict(list)
    for c in b.customers:
        dob = parse_date(c.get("dob"))
        if dob:
            b.by_dob_year[dob.year].append(c)
        for ctry in customer_declared_countries(c):
            b.by_country[ctry].append(c)
    return b


def customer_declared_countries(c):
    return countries_from_values([c.get("residence_country"), c.get("nationality")])


def customer_names(c):
    names = []
    for k in ("full_name", "preferred_name", "login_name"):
        v = c.get(k)
        if v and v not in names:
            names.append(v)
    return names


def company_incorporation_date(records):
    """Use only an explicitly labelled company incorporation field.

    A DOB field, support note, or KYC note may describe a natural person behind
    the company.  Treating it as the company's incorporation date could create
    an unsafe DOB or temporal clearance.
    """
    for record in records:
        for field in ("incorporation_date", "incorporated_on", "registration_date"):
            parsed = parse_date(record.get(field))
            if parsed:
                return parsed
    return None


# =============================================================================
# Customer resolution
# =============================================================================

def notes_for_records(bank, records):
    notes, seen = [], set()
    for c in records:
        em = c.get("email")
        em = em.lower() if isinstance(em, str) else (str(em).lower() if em else "")
        if not em:
            continue
        for n in bank.notes_by_email.get(em, []):
            nid = n.get("note_id")
            if nid in seen:
                continue
            seen.add(nid)
            notes.append(n)
    notes.sort(key=lambda n: n.get("note_id") or "")
    return notes


def lived_countries(notes):
    found, seen = [], set()
    for n in notes:
        if (n.get("channel") or "").lower() == "kyc":
            continue
        text = n.get("text") or ""
        if not LIVED_RE.search(text):
            continue
        for c in countries_in_text(text):
            if c not in seen:
                seen.add(c)
                found.append((c, n.get("note_id")))
    return found


def latest_approved_identity(bank, records, notes):
    """Most recent approved check, provider or onboarding note (principle 4)."""
    cands = []
    for c in records:
        for k in bank.approved_kyc_for.get(c["record_id"], []):
            cands.append({
                "source": "kyc",
                "check_id": k.get("check_id"),
                "note_id": None,
                "verified_name": k.get("verified_name"),
                "verified_dob": parse_date(k.get("verified_dob")),
                "document_country": country_of(k.get("document_country")),
                "document_country_raw": k.get("document_country"),
                "document_number": k.get("document_number"),
                "checked_at": parse_date(k.get("checked_at")),
                "result": "approved",
            })
    for n in notes:
        if (n.get("channel") or "").lower() != "kyc":
            continue
        parsed = parse_kyc_note(n)
        if parsed:
            cands.append(parsed)
    if not cands:
        return None

    def sk(c):
        iso = c["checked_at"].iso() if c["checked_at"] else ""
        ident = c.get("check_id") or c.get("note_id") or ""
        return (iso, ident)

    cands.sort(key=sk)
    return cands[-1]


def screened_fits(customer, screened, bank):
    """Principle 2: name, DOB (every shared part), country, city."""
    sc_name = (screened or {}).get("name")
    sc_dob = parse_date((screened or {}).get("dob"))
    sc_country = country_of((screened or {}).get("country"))
    sc_city = (screened or {}).get("city")
    company = (customer.get("entity_type") or "").lower() == "company"
    if sc_name:
        if not bank.ns.any_agree(customer_names(customer), [sc_name], company=company):
            return False
    if sc_dob:
        cd = parse_date(customer.get("dob"))
        if not cd or not sc_dob.equal_known(cd):
            return False
    if sc_country:
        if sc_country not in customer_declared_countries(customer):
            return False
    if sc_city:
        city = strip_accents(str(sc_city)).lower()
        blob = strip_accents(" ".join(filter(None, [customer.get("city"), customer.get("address")]))).lower()
        if city not in blob:
            return False
    return True


def shared_contact_namesakes(records, bank):
    """Return distinct same-name people sharing both contact identifiers.

    A shared phone or address is not enough to merge people.  When both are
    shared by a namesake with a conflicting DOB, or when the linked record has
    no usable DOB, retain both candidates for separate evaluation. That can
    only produce REVIEW/AMBIGUOUS; it cannot create a clearance.
    """
    out, seen = [], {record.get("record_id") for record in records}
    for record in records:
        if not is_person(record.get("entity_type")):
            continue
        phone = normalise_phone(record.get("phone"))
        address = norm_space(strip_accents(str(record.get("address") or "")).lower())
        dob = parse_date(record.get("dob"))
        if not phone or not address:
            continue
        for other in bank.customers_by_phone.get(phone, []):
            other_id = other.get("record_id")
            if not other_id or other_id in seen:
                continue
            if bank.cluster_of.get(other_id, other_id) == bank.cluster_of.get(record.get("record_id"), record.get("record_id")):
                continue
            other_address = norm_space(strip_accents(str(other.get("address") or "")).lower())
            other_dob = parse_date(other.get("dob"))
            if address != other_address or not other_dob or not other_dob.has_full():
                continue
            # If the linked record has no usable DOB, a same-contact namesake
            # is still unresolved.  If it has one, require a hard conflict so
            # two records of the same person are not split accidentally.
            if dob and dob.has_full() and not dob.contradicts(other_dob):
                continue
            if not bank.ns.any_agree(customer_names(record), customer_names(other), company=False):
                continue
            seen.add(other_id)
            out.append(other)
    out.sort(key=lambda record: record.get("record_id") or "")
    return out


def seed_records(alert, bank):
    """Follow the alert's link; if it leads to several people, screened details pick."""
    seeds, seen = [], set()

    def add(cid):
        if cid and cid in bank.customers_by_id and cid not in seen:
            seen.add(cid)
            seeds.append(bank.customers_by_id[cid])

    ref = alert.get("account_ref")
    login = alert.get("login_handle")
    email = alert.get("email")
    linked = False
    if ref:
        rows = bank.accounts_by_id.get(ref, [])
        if rows:
            linked = True
            for a in rows:
                add(a.get("customer_id"))
    if login:
        rows = bank.accounts_by_login.get(login, []) or bank.accounts_by_login.get(str(login).lower(), [])
        if rows:
            linked = True
            for a in rows:
                add(a.get("customer_id"))
    if email:
        rows = bank.customers_by_email.get(str(email).lower(), [])
        if rows:
            linked = True
            for c in rows:
                add(c["record_id"])

    screened = alert.get("customer") or {}
    if not linked:
        # no link: search customers that fit what was screened
        return unlinked_search(screened, bank)

    # Do not merge a same-address, same-phone namesake whose DOB conflicts or
    # whose linked record lacks a usable DOB. Keep both candidate people so
    # downstream policy resolution can return AMBIGUOUS_CUSTOMER_RECORD.
    namesakes = shared_contact_namesakes(seeds, bank)
    namesake_ids = {record.get("record_id") for record in namesakes}
    seeds.extend(namesakes)

    # A link can lead to more than one person; screened details then pick.
    # If only one seed so far, keep it (expand later). If several, filter.
    # Distinct people? We'll filter when more than one seed record does not
    # already belong to one cluster OR when joint holders are different people.
    clusters = {bank.cluster_of.get(c["record_id"]) for c in seeds}
    if len(seeds) > 1 and len(clusters) > 1:
        fitted = [c for c in seeds if screened_fits(c, screened, bank)]
        if fitted:
            # A full screened DOB normally selects one joint holder, but it
            # cannot erase a separately recorded same-contact namesake.
            return fitted + [c for c in seeds if c.get("record_id") in namesake_ids and c not in fitted]
        # if none fit, don't use another customer's records: return empty? or all?
        # "Never use another customer's records." If we can't pick, treat as all
        # candidates and later AMBIGUOUS. Keep seeds (they're from the link).
    return seeds


def unlinked_search(screened, bank):
    sc_dob = parse_date((screened or {}).get("dob"))
    sc_country = country_of((screened or {}).get("country"))
    # candidate pool
    pool = None
    if sc_dob and sc_dob.year:
        pool = list(bank.by_dob_year.get(sc_dob.year, []))
        # year tolerance is NOT used for this equality test — exact year required
    elif sc_country:
        pool = list(bank.by_country.get(sc_country, []))
    else:
        pool = bank.customers
    out = []
    for c in pool:
        if screened_fits(c, screened, bank):
            out.append(c)
    return out


def expand_person(records, bank):
    """All records in the same principle-3 clusters as the seeds."""
    seen, out = set(), []
    for c in records:
        root = bank.cluster_of.get(c["record_id"], c["record_id"])
        for mid in bank.cluster_members.get(root, [c["record_id"]]):
            if mid not in seen and mid in bank.customers_by_id:
                seen.add(mid)
                out.append(bank.customers_by_id[mid])
    out.sort(key=lambda c: c["record_id"])
    return out


def group_people(seed_records_, bank):
    """Group seed+expanded records into distinct people."""
    if not seed_records_:
        return []
    # expand each seed, union records of the same cluster
    buckets = {}
    for c in seed_records_:
        root = bank.cluster_of.get(c["record_id"], c["record_id"])
        buckets.setdefault(root, [])
    # fill from expanded
    expanded = expand_person(seed_records_, bank)
    for c in expanded:
        root = bank.cluster_of.get(c["record_id"], c["record_id"])
        if root in buckets:
            buckets[root].append(c)
    # also include seeds that somehow missed
    for c in seed_records_:
        root = bank.cluster_of.get(c["record_id"], c["record_id"])
        if c not in buckets.get(root, []):
            buckets.setdefault(root, []).append(c)
    people = []
    for root, recs in sorted(buckets.items(), key=lambda kv: kv[0] or ""):
        # unique
        u, seen = [], set()
        for c in recs:
            if c["record_id"] not in seen:
                seen.add(c["record_id"])
                u.append(c)
        u.sort(key=lambda c: c["record_id"])
        people.append(u)
    return people


def build_person(records, bank, screened=None):
    notes = notes_for_records(bank, records)
    ident = latest_approved_identity(bank, records, notes)
    names = []
    for c in records:
        for n in customer_names(c):
            if n not in names:
                names.append(n)
    declared_dobs = []
    for c in records:
        d = parse_date(c.get("dob"))
        if d and d not in declared_dobs:
            declared_dobs.append(d)
    countries = []
    seen_c = set()
    for c in records:
        for x in customer_declared_countries(c):
            if x not in seen_c:
                seen_c.add(x)
                countries.append(x)
    doc_countries = []
    if ident and ident.get("document_country"):
        doc_countries.append(ident["document_country"])
        if ident["document_country"] not in seen_c:
            seen_c.add(ident["document_country"])
            countries.append(ident["document_country"])
    lived = lived_countries(notes)
    lived_ids = []
    for ctry, nid in lived:
        lived_ids.append(nid)
        if ctry not in seen_c:
            seen_c.add(ctry)
            countries.append(ctry)
    unrecognised = unrecognised_countries(
        [c.get(k) for c in records for k in ("residence_country", "nationality")]
        + [ident.get("document_country_raw") if ident else None]
    )
    etypes = {(c.get("entity_type") or "") for c in records}
    has_co = any(is_company(t) for t in etypes)
    has_ind = any(is_person(t) for t in etypes)
    if has_co and not has_ind:
        etype = "Company"
    elif has_ind and not has_co:
        etype = "Individual"
    else:
        etype = (records[0].get("entity_type") if records else None) or (
            (screened or {}).get("entity_type")
        )
    verified_name = ident["verified_name"] if ident else None
    verified_dob = ident["verified_dob"] if ident else None
    dob = verified_dob or (declared_dobs[0] if declared_dobs else None)
    # DOB-like values are never incorporation evidence.  Companies need an
    # explicitly labelled incorporation field before a temporal/DOB clearance.
    incorp = company_incorporation_date(records) if etype == "Company" else None
    rec_ids = [c["record_id"] for c in records]
    return {
        "records": records,
        "record_ids": rec_ids,
        "customer_record_id": rec_ids[0] if rec_ids else None,  # any is accepted
        "notes": notes,
        "ident": ident,
        "names": names,
        "verified_name": verified_name,
        "dob": dob,
        "declared_dobs": declared_dobs,
        "countries": countries,
        "unrecognised_countries": unrecognised,
        "lived_note_ids": [n for n in lived_ids if n],
        "entity_type": etype,
        "incorporation": incorp,
    }


def resolve_people(alert, bank):
    seeds = seed_records(alert, bank)
    groups = group_people(seeds, bank)
    screened = alert.get("customer") or {}
    people = [build_person(g, bank, screened) for g in groups]
    people.sort(key=lambda p: p["customer_record_id"] or "")
    return people

# =============================================================================
# Hit facts (principle 5)
# =============================================================================

DATED_REPORT_RE = re.compile(
    r"According to .+?;\s*("
    r"(?:January|February|March|April|May|June|July|August|September|October|November|December)"
    r"(?:\s+\d{1,2},)?\s+\d{4}"
    r")\s*:",
    re.I,
)

AGE_PATTERNS = [
    # aged 45 when/in March 2019; aged 30, in November 1998; aged 46, ... in January 2023
    re.compile(
        r"\b(?:aged?|age)\s+(\d{1,3})(?:\s+years?(?:\s+old)?)?"
        r"(?:[^0-9]{0,80}?)"
        r"(?:in|on|as of|as at|from|during)\s+"
        r"((?:January|February|March|April|May|June|July|August|September|October|November|December|"
        r"Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)\.?(?:\s+\d{1,2},)?\s+)?(\d{4})\b",
        re.I,
    ),
    # at the age of 33, ... in February 2010
    re.compile(
        r"\bat the age of\s+(\d{1,3})"
        r"(?:[^0-9]{0,80}?)"
        r"(?:in|on|as of|from|during)\s+"
        r"((?:January|February|March|April|May|June|July|August|September|October|November|December|"
        r"Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)\.?(?:\s+\d{1,2},)?\s+)?(\d{4})\b",
        re.I,
    ),
    # 33 year old X ... in May 2019  OR  In February 2010, ... 33 year old
    re.compile(
        r"(?:(?:in|on|from)\s+"
        r"((?:January|February|March|April|May|June|July|August|September|October|November|December|"
        r"Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)\.?(?:\s+\d{1,2},)?\s+)?(\d{4})"
        r"[^0-9]{0,80}?)?"
        r"\b(\d{1,3})\s*(?:-?\s*)?(?:year(?:s)?[\s-]?old|years old)\b"
        r"(?:[^0-9]{0,80}?(?:in|on|from)\s+"
        r"((?:January|February|March|April|May|June|July|August|September|October|November|December|"
        r"Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)\.?(?:\s+\d{1,2},)?\s+)?(\d{4}))?",
        re.I,
    ),
    # "X, 52, who was ... from June 2012" / "listed X, 29, a politically"
    re.compile(
        r",\s+(\d{1,3}),\s+"
        r"(?:[^0-9]{0,120}?)"
        r"(?:in|from|on)\s+"
        r"((?:January|February|March|April|May|June|July|August|September|October|November|December|"
        r"Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)\.?(?:\s+\d{1,2},)?\s+)?(\d{4})\b",
        re.I,
    ),
]


def first_paragraph(text):
    if not text:
        return ""
    parts = re.split(r"\n\s*\n", text.strip(), maxsplit=1)
    return parts[0]


def ages_to_years(age, year):
    age, year = int(age), int(year)
    if not (0 < age < 120 and 1800 <= year <= 2100):
        return []
    return [year - age - 1, year - age]


def extract_age_years(text):
    """Pair an age with a nearby date (typically the same sentence)."""
    years, phrases = [], []
    if not text:
        return years, phrases
    age_res = [
        re.compile(r"\b(?:aged?|age)\s+(\d{1,3})\b", re.I),
        re.compile(r"\bat (?:the )?age of\s+(\d{1,3})\b", re.I),
        re.compile(r"\breached the age of\s+(\d{1,3})\b", re.I),
        re.compile(r"\ba\s+(\d{1,3})-year-old\b", re.I),
        re.compile(r"\b(\d{1,3})\s*-?\s*year(?:s)?[\s-]?old\b", re.I),
        re.compile(r"\b(\d{1,3})\s+years\s+of\s+age\b", re.I),
        re.compile(r"\b(?:he|she|they|who)\s+was\s+(\d{1,3})\b", re.I),
        re.compile(r",\s+(\d{1,3}),\s+"),
    ]
    date_re = re.compile(
        r"(?:January|February|March|April|May|June|July|August|September|October|November|December|"
        r"Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)\.?"
        r"(?:\s+\d{1,2},)?\s+\d{4}"
        r"|\b(?:in|on|of|from|during|saw)\s+(19|20)\d{2}\b",
        re.I,
    )
    seen = set()
    for are in age_res:
        for am in are.finditer(text):
            age = int(am.group(1))
            if not (1 <= age <= 119):
                continue
            # search a window around the age for a month/year
            lo = max(0, am.start() - 160)
            hi = min(len(text), am.end() + 160)
            window = text[lo:hi]
            # prefer a month-named date, closest to the age
            cands = []
            for dm in date_re.finditer(window):
                raw = dm.group(0)
                d = parse_date(raw)
                if not d:
                    ym = re.search(r"(19|20)\d{2}", raw)
                    if ym:
                        d = parse_date(ym.group(0))
                if not d:
                    continue
                # position of date in full text
                pos = lo + dm.start()
                dist = min(abs(pos - am.start()), abs(pos - am.end()))
                has_month = bool(d.month)
                cands.append((0 if has_month else 1, dist, d, dm.group(0)))
            if not cands:
                for ym in re.finditer(r"\b((?:19|20)\d{2})\b", window):
                    d = parse_date(ym.group(1))
                    if d:
                        pos = lo + ym.start()
                        cands.append((1, min(abs(pos - am.start()), abs(pos - am.end())), d, ym.group(0)))
            if not cands:
                continue
            cands.sort()
            _rank, _dist, d, dstr = cands[0]
            phrase = text[min(am.start(), lo + date_re.search(window).start() if False else am.start()): am.end()]
            phrase = (dstr + " / age " + str(age)).strip()
            for y in ages_to_years(age, d.year):
                if y not in seen:
                    seen.add(y)
                    years.append(PDate(y))
            phrases.append(phrase)
    return years, phrases



def listing_phrase_for(hit):
    cat = (hit.get("primary_category") or "")
    if not cat:
        cats = as_list(hit.get("categories"))
        cat = cats[0] if cats else ""
    key = (cat or "").strip().lower()
    return LISTING_PHRASE.get(key, DEFAULT_LISTING_PHRASE)


def hit_countries(hit):
    vals = []
    for key in ("countries", "nationality", "citizenship"):
        v = hit.get(key)
        if isinstance(v, list):
            vals.extend(v)
        elif v:
            vals.append(v)
    if hit.get("place_of_birth"):
        vals.append(hit["place_of_birth"])
    for addr in as_list(hit.get("addresses")):
        c = last_address_country(addr)
        if c:
            vals.append(c)
    return countries_from_values(vals)


def hit_unrecognised_countries(hit):
    vals = [hit.get(k) for k in ("countries", "nationality", "citizenship", "place_of_birth")]
    for addr in as_list(hit.get("addresses")):
        # An address is unrecognised only when no part of it names a country.
        if addr and not last_address_country(addr):
            parts = [p for p in re.sub(r"\[.*?\]", "", str(addr)).split(",") if p.strip()]
            if parts:
                vals.append(parts[-1])
    return unrecognised_countries(vals)


def hit_names(hit):
    names = []
    for key in ("name", "best_matching_name", "first_name", "middle_name", "last_name"):
        # first/middle/last alone are not full names; collect full ones first
        pass
    for key in ("name", "best_matching_name"):
        v = hit.get(key)
        if isinstance(v, (list, tuple)):
            for item in v:
                t = as_text(item)
                if t and t not in names:
                    names.append(t)
            continue
        t = as_text(v)
        if t and t not in names:
            names.append(t)
    for a in as_list(hit.get("aliases")):
        alias_text = re.sub(r"\s*\((?:AKA|FKA|NKA)\)\s*$", "", as_text(a), flags=re.I).strip()
        if alias_text and alias_text not in names:
            names.append(alias_text)
    # constructed "first middle last" if pieces exist
    pieces = [as_text(hit.get("first_name")), as_text(hit.get("middle_name")), as_text(hit.get("last_name"))]
    built = " ".join(p for p in pieces if p)
    if built and built not in names:
        names.append(built)
    return names


def dated_reports(profile_notes):
    dates = []
    if not profile_notes:
        return dates
    for m in DATED_REPORT_RE.finditer(profile_notes):
        d = parse_date(m.group(1))
        if d:
            dates.append(d)
    return dates


_DEATH_RE = re.compile(
    r"\b(?:died|deceased|date of death|passed away|death)\b\s*[:,(]?\s*(?:on\s+|in\s+|:\s*)?"
    r"(\d{4}-\d{2}(?:-\d{2})?|\d{1,2}/\d{1,2}/\d{4}|"
    r"(?:\d{1,2}\s+)?(?:January|February|March|April|May|June|July|August|"
    r"September|October|November|December|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)"
    r"(?:\s+\d{1,2},?)?\s+\d{4}|\d{4})\b",
    re.I,
)
# A death in the notes must be the listed person's, not a relative's or a victim's.
_OTHER_PERSON_RE = re.compile(
    r"\b(?:late|father|mother|wife|husband|son|daughter|brother|sister|spouse|partner|uncle|aunt|"
    r"cousin|relative|grandfather|grandmother|parent|parents|child|children|associate|victim|victims|"
    r"people|persons|man|woman|men|women|who|whose|after|following|killed|murder(?:ed)?)\b",
    re.I,
)


def death_date(hit):
    d = parse_date(hit.get("deceased_date"))
    if d:
        return d
    notes = hit.get("profile_notes") or ""
    if not isinstance(notes, str):
        notes = str(notes)
    notes = _normalise_date_text(notes)
    status = str(hit.get("life_status") or "").strip().lower()
    deceased_flag = status in ("deceased", "dead")
    for m in _DEATH_RE.finditer(notes):
        # Free-text wording ("died", "passed away", ...) counts only when the profile is also
        # flagged deceased; otherwise only a labelled "Date of death:" is the provider's own field.
        labelled = m.group(0).lower().startswith("date of death")
        if not (labelled or deceased_flag):
            continue
        # same sentence, text before the death word
        start = max(notes.rfind(".", 0, m.start()), notes.rfind("\n", 0, m.start())) + 1
        before = notes[start:m.start()]
        if _OTHER_PERSON_RE.search(before[-60:]):
            continue
        got = parse_date(m.group(1))
        if got:
            return got
    return None


def search_rows_for_hit(hit, bank):
    names = hit_names(hit)
    rows, seen = [], set()

    def add_list(lst):
        for s in lst:
            rid = s.get("result_id")
            if rid in seen:
                continue
            seen.add(rid)
            rows.append(s)

    for name in names:
        q = strip_accents(name).lower()
        q = re.sub(r"[^\w\s]", " ", q)
        q = re.sub(r"\s+", " ", q).strip()
        if not q:
            continue
        add_list(bank.search_by_query.get(q, []))
        add_list(bank.search_by_sorted.get(" ".join(sorted(q.split())), []))
        # last, first -> first last
        if "," in name:
            bits = [p.strip() for p in name.split(",", 1)]
            if len(bits) == 2 and bits[0] and bits[1]:
                q2 = strip_accents(bits[1] + " " + bits[0]).lower()
                q2 = re.sub(r"[^\w\s]", " ", q2)
                q2 = re.sub(r"\s+", " ", q2).strip()
                add_list(bank.search_by_query.get(q2, []))
                add_list(bank.search_by_sorted.get(" ".join(sorted(q2.split())), []))
    # queries drop initials and middle names: also accept rows whose query tokens
    # (>= 2) are a subset of this hit name's non-initial tokens
    idx = getattr(bank, "_search_by_tokset", None)
    if idx is None:
        idx = defaultdict(list)
        for q, lst in bank.search_by_query.items():
            idx[frozenset(q.split())].extend(lst)
        bank._search_by_tokset = idx
    from itertools import combinations
    for name in names:
        q = re.sub(r"[^\w\s]", " ", strip_accents(name).lower())
        toks = sorted({t for t in q.split() if len(t) > 1})
        if len(toks) > 6:
            continue
        for k in range(2, len(toks) + 1):
            for comb in combinations(toks, k):
                add_list(idx.get(frozenset(comb), []))
    rows.sort(key=lambda s: s.get("result_id") or "")
    return rows


def result_is_about_hit(result, hit, countries):
    """Same kind of listing, in a country tied to the hit (principle 5)."""
    blob = " ".join(filter(None, [as_text(result.get("title")), as_text(result.get("snippet"))]))
    if not blob:
        return False
    phrase = listing_phrase_for(hit)
    if phrase.lower() not in blob.lower():
        return False
    if not countries:
        return False
    text_countries = set(countries_in_text(blob))
    # also direct alias of a hit country in the text
    low = strip_accents(blob).lower()
    for c in countries:
        if c in text_countries:
            return True
        if c.lower() in low:
            return True
    return False


def extract_hit(hit, bank):
    names = hit_names(hit)
    etype = hit.get("entity_type")
    countries = hit_countries(hit)
    raw_dobs = as_list(hit.get("dobs"))
    structured_dobs, dob_unreadable = [], False
    for d in raw_dobs:
        pd = parse_date(d)
        if pd:
            structured_dobs.append(pd)
        elif d is not None and str(d).strip() and str(d).strip().lower() not in PLACEHOLDERS:
            # a birth date we cannot read could be the one that agrees: never clear on the others
            dob_unreadable = True
    profile = _normalise_date_text(as_text(hit.get("profile_notes")))
    first = first_paragraph(profile)
    note_years, note_phrases = extract_age_years(first)
    # For companies, only the dobs field is an incorporation date.
    dobs = list(structured_dobs)
    dob_sources = []
    if not is_company(etype):
        if note_years:
            for d in note_years:
                if d not in dobs:
                    dobs.append(d)
            dob_sources.append(("profile_notes", note_phrases, None))
    search_used = []
    search_phrases = []
    if not is_company(etype) and not structured_dobs and not note_years:
        for row in search_rows_for_hit(hit, bank):
            if not result_is_about_hit(row, hit, countries):
                continue
            blob = _normalise_date_text(" ".join(filter(None, [as_text(row.get("title")), as_text(row.get("snippet"))])))
            yrs, ph = extract_age_years(blob)
            # also "born 1962"
            if not yrs:
                m = re.search(r"\bborn(?:\s+in|\s+on)?\s+(\d{4}|\d{4}-\d{2}-\d{2})", blob, re.I)
                if m:
                    d = parse_date(m.group(1))
                    if d:
                        yrs = [d]
                        ph = [m.group(0)]
            if yrs:
                for d in yrs:
                    if d not in dobs:
                        dobs.append(d)
                search_used.append(row)
                search_phrases.extend(ph)
        if search_used:
            dob_sources.append(("search", search_phrases, [s["result_id"] for s in search_used]))
    reports = dated_reports(profile)
    death = death_date(hit)
    return {
        "hit": hit,
        "hit_id": hit.get("hit_id"),
        "names": names,
        "entity_type": etype,
        "countries": countries,
        "unrecognised_countries": hit_unrecognised_countries(hit),
        "dobs": dobs,
        "structured_dobs": structured_dobs,
        "dob_unreadable": dob_unreadable,
        "dob_sources": dob_sources,
        "search_used": search_used,
        "dated_reports": reports,
        "death": death,
        "life_status": hit.get("life_status"),
        "profile": profile,
    }


# =============================================================================
# Comparisons and decisions
# =============================================================================

_COMPANY_TYPES = {"company", "organisation", "organization", "corporation", "corporate",
                  "business", "legal entity", "legal person", "firm", "enterprise"}
_PERSON_TYPES = {"individual", "person", "natural", "natural person", "private individual"}


def canon_etype(etype):
    t = re.sub(r"\s+", " ", str(etype or "")).strip().lower()
    if t in _COMPANY_TYPES:
        return "Company"
    if t in _PERSON_TYPES:
        return "Individual"
    return etype


def is_company(etype):
    return (canon_etype(etype) or "") == "Company"


def is_person(etype):
    return canon_etype(etype) == "Individual"


def type_mismatch(person, hitf):
    a, b = person.get("entity_type"), hitf.get("entity_type")
    return (is_person(a) and is_company(b)) or (is_company(a) and is_person(b))


def age_bounds(dob, event):
    if not dob or not event:
        return None, None
    d0, d1 = dob.date_min(), dob.date_max()
    e0, e1 = event.date_min(), event.date_max()
    if not d0 or not e1:
        return None, None

    def years_between(later, earlier):
        y = later.year - earlier.year
        if (later.month, later.day) < (earlier.month, earlier.day):
            y -= 1
        return y

    # min age: latest dob, earliest event; max age: earliest dob, latest event
    return years_between(e0, d1), years_between(e1, d0)


def earliest_report(hitf):
    dates = [d for d in hitf.get("dated_reports") or [] if d]
    if not dates:
        return None
    dates.sort(key=lambda d: (d.year or 9999, d.month or 1, d.day or 1))
    return dates[0]


def temporal_impossibility(person, hitf):
    event = earliest_report(hitf)
    if not event:
        return False, None
    if is_company(person.get("entity_type")) or is_company(hitf.get("entity_type")):
        inc = person.get("incorporation")
        if inc:
            i0, e1 = inc.date_min(), event.date_max()
            if i0 and e1 and i0 > e1:
                return True, ("incorporated", inc, event)
        return False, None
    dob = person.get("dob")
    if not dob:
        return False, None
    min_age, max_age = age_bounds(dob, event)
    if max_age is not None and max_age < MIN_AGE_AT_EVENT:
        return True, ("too_young", dob, event, max_age)
    return False, None


def deceased_before_screening(person, hitf, alert):
    death = hitf.get("death")
    screen = parse_date(alert.get("screened_at"))
    if not death or not screen:
        return False, None
    d1, s0 = death.date_max(), screen.date_min()
    if d1 and s0 and d1 < s0:
        return True, (death, screen)
    return False, None


def dob_contradicts(person, hitf):
    """Every birth date the hit gives is contradicted. One agreeing date blocks this."""
    cust = person.get("dob")
    # companies: incorporation date vs hit dobs
    if is_company(person.get("entity_type")):
        cust = person.get("incorporation") or cust
    hits = hitf.get("dobs") or []
    if not cust or not hits or hitf.get("dob_unreadable"):
        return False
    for hd in hits:
        if not cust.contradicts(hd):
            return False
    return True


def dob_agrees(person, hitf):
    cust = person.get("dob")
    hits = hitf.get("dobs") or []
    if not cust or not hits:
        return False
    for hd in hits:
        if cust.agrees(hd):
            return True
    return False


def name_agrees(person, hitf, bank, use_verified=True):
    company = is_company(person.get("entity_type")) or is_company(hitf.get("entity_type"))
    cust_names = []
    if use_verified and person.get("verified_name"):
        cust_names = [person["verified_name"]]
    else:
        cust_names = list(person.get("names") or [])
        if person.get("verified_name") and person["verified_name"] not in cust_names:
            cust_names.insert(0, person["verified_name"])
    return bank.ns.any_agree(cust_names, hitf.get("names") or [], company=company)


def verified_name_mismatch(person, hitf, bank):
    vname = person.get("verified_name")
    if not vname:
        return False
    company = is_company(person.get("entity_type"))
    parts = bank.ns.parts(vname, company=company)
    # Individual whose verified name has < 2 real parts: cannot clear on name
    if is_person(person.get("entity_type")) and len(parts) < 2:
        return False
    return not bank.ns.any_agree([vname], hitf.get("names") or [], company=company)


def location_mismatch(person, hitf):
    a = person.get("countries") or []
    b = hitf.get("countries") or []
    if not a or not b:
        return False  # missing is not a mismatch
    return set(a).isdisjoint(set(b))


def location_agrees(person, hitf):
    a = person.get("countries") or []
    b = hitf.get("countries") or []
    if not a or not b:
        return False
    return not set(a).isdisjoint(set(b))


def splink_style_profile(person, hitf, bank, name_agreement, dob_agreement,
                         country_agreement, country_mismatch):
    """Build deterministic comparison levels before a policy decision.

    Unknown values are never treated as a mismatch. This mirrors the useful
    structure of Fellegi-Sunter linkage without training or external data.
    """
    if type_mismatch(person, hitf):
        type_level = "contradict"
    elif person.get("entity_type") and hitf.get("entity_type"):
        type_level = "agree"
    else:
        type_level = "unknown"
    if name_agreement:
        name_level = "agree"
    elif verified_name_mismatch(person, hitf, bank):
        name_level = "contradict"
    else:
        name_level = "unknown"
    if dob_agreement:
        dob_level = "agree"
    elif dob_contradicts(person, hitf):
        dob_level = "contradict"
    else:
        dob_level = "unknown"
    country_level = "agree" if country_agreement else (
        "contradict" if country_mismatch else "unknown"
    )
    levels = {
        "name": name_level,
        "dob": dob_level,
        "country": country_level,
        "entity_type": type_level,
    }
    score, threshold = linkage_score(
        levels,
        company=is_company(person.get("entity_type")) or is_company(hitf.get("entity_type")),
    )
    return {"levels": levels, "score": score, "threshold": threshold}


def _location_countries(person, hitf, agrees):
    pc = set(person.get("countries") or [])
    hc = set(hitf.get("countries") or [])
    if agrees:
        return pc & hc
    return pc


def deciding_evidence(person, hitf, decision, key, l_ok=False, l_mis=False):
    """Cite only the records that decided the call, not everything inspected.

    Lived-in notes are included only when their country is part of the location
    used in the decision. Customer records are omitted for a pure date-of-birth
    or verified-name contradiction, matching the practice-label evidence lists.
    On an INSUFFICIENT_DATA review, an identity check is omitted when the hit
    has no date of birth to compare and location already comes from a lived note.
    """
    # Recompute location here: some contradictions return before decide_one
    # has set l_ok / l_mis (verified-name mismatch is one).
    if location_agrees(person, hitf):
        l_ok = True
    if location_mismatch(person, hitf):
        l_mis = True
    ev = []
    ident = person.get("ident")
    ident_ids = []
    if ident:
        if ident.get("check_id"):
            ident_ids.append(ident["check_id"])
        if ident.get("note_id") and ident.get("note_id") not in ident_ids:
            ident_ids.append(ident["note_id"])

    used_location = key in {
        "LOCATION_MISMATCH", "NAME_DOB_LOCATION_MATCH", "NAME_LOCATION_MATCH",
    } or (key == "INSUFFICIENT_DATA" and (l_ok or l_mis))
    loc_set = _location_countries(person, hitf, agrees=l_ok) if used_location else set()

    lived_ids = []
    if used_location:
        # Map lived note -> countries recorded on the person build
        # We only have ids; re-derive from notes if present.
        note_by_id = {n.get("note_id"): n for n in (person.get("notes") or []) if n.get("note_id")}
        for nid in person.get("lived_note_ids") or []:
            n = note_by_id.get(nid)
            countries = set(countries_in_text((n or {}).get("text") or "")) if n else set()
            if not countries or (countries & loc_set):
                lived_ids.append(nid)

    hit_has_dob = bool(hitf.get("dobs") or [])
    # Pure identity contradictions: the check or note is the proof.
    omit_cus = key in {"DOB_MISMATCH", "NAME_MISMATCH_VERIFIED"} and not l_mis
    # Review where location is carried by a lived note and DOB was not compared:
    # the lived note is the deciding record (practice labels omit CUS + ident).
    omit_ident = (
        key == "INSUFFICIENT_DATA"
        and not hit_has_dob
        and bool(lived_ids)
        and not (ident and ident.get("document_country") and ident.get("document_country") in loc_set)
    )
    # Always keep customer record ids on REVIEW: practice labels sometimes
    # cite only the lived note, but sometimes also the customer, and a miss
    # is worse than one extra CUS id.

    if not omit_cus:
        ev.extend(person.get("record_ids") or [])
    if not omit_ident:
        ev.extend(ident_ids)
    ev.extend(lived_ids)
    dob_used = key in {
        "DOB_MISMATCH", "TEMPORAL_IMPOSSIBILITY", "NAME_DOB_MATCH",
        "NAME_DOB_LOCATION_MATCH",
    } or (key == "INSUFFICIENT_DATA" and hit_has_dob)
    if dob_used or key in {"NAME_DOB_MATCH", "NAME_DOB_LOCATION_MATCH", "DOB_MISMATCH"}:
        for s in hitf.get("search_used") or []:
            ev.append(s.get("result_id"))
    seen, out = set(), []
    for x in ev:
        if x and x not in seen:
            seen.add(x)
            out.append(x)
    return out


def decide_one(person, hitf, alert, bank):
    """Return (decision, reason_key, detail, evidence)."""
    ident = person.get("ident")

    def pack(decision, key, detail, l_ok=False, l_mis=False):
        out = deciding_evidence(person, hitf, decision, key, l_ok=l_ok, l_mis=l_mis)
        return decision, key, detail, out

    # Type
    if type_mismatch(person, hitf):
        return pack(
            "DIFFERENT_ENTITY",
            "ENTITY_TYPE_MISMATCH",
            f"The customer is a {person.get('entity_type')} and the listed profile is a {hitf.get('entity_type')}.",
        )

    # Deceased
    dead, meta = deceased_before_screening(person, hitf, alert)
    if dead:
        death, screen = meta
        return pack(
            "DIFFERENT_ENTITY",
            "DECEASED",
            f"The listed profile gives a date of death of {death.iso()}, which is before the customer was screened ({screen.iso()}).",
        )

    # Temporal
    temp, meta = temporal_impossibility(person, hitf)
    if temp:
        if meta[0] == "too_young":
            dob, event, max_age = meta[1], meta[2], meta[3]
            return pack(
                "DIFFERENT_ENTITY",
                "TEMPORAL_IMPOSSIBILITY",
                f"The customer's date of birth is {dob.iso()}{ident_cite(ident)}, so they were at most {max_age} years old at the earliest dated report ({event.iso()}), below {MIN_AGE_AT_EVENT}.",
            )
        inc, event = meta[1], meta[2]
        return pack(
            "DIFFERENT_ENTITY",
            "TEMPORAL_IMPOSSIBILITY",
            f"The company was incorporated on {inc.iso()}, which is after the earliest dated report ({event.iso()}).",
        )

    # DOB
    if dob_contradicts(person, hitf):
        ciso = person.get("dob").iso() if person.get("dob") else "unknown"
        hiso = ", ".join(d.iso() for d in hitf.get("dobs") or []) or "unknown"
        result = pack(
            "DIFFERENT_ENTITY",
            "DOB_MISMATCH",
            f"The customer's date of birth is {ciso}{ident_cite(ident)} but the hit's date of birth is {hiso}.",
        )
        # Cite what decided it: the approved check that gave the date, plus any search result
        # that gave the hit's date. Not every record we looked at (README: reasons scoring).
        _iid = (ident.get("check_id") or ident.get("note_id")) if ident and ident.get("verified_dob") else None
        if _iid and not is_company(person.get("entity_type")):
            only = [_iid] + [x.get("result_id") for x in (hitf.get("search_used") or []) if x.get("result_id")]
            result = result[:3] + ([x for i, x in enumerate(only) if x and x not in only[:i]],)
        return result

    # Verified name
    if verified_name_mismatch(person, hitf, bank):
        hitn = (hitf.get("names") or ["the listed name"])[0]
        ident_id = ""
        if ident:
            ident_id = ident.get("check_id") or ident.get("note_id") or ""
        src = f" ({ident_id})" if ident_id else ""
        result = pack(
            "DIFFERENT_ENTITY",
            "NAME_MISMATCH_VERIFIED",
            f"The customer's verified name is {person.get('verified_name')}{src}, which does not match the hit's name {hitn}.",
        )
        if ident_id and not location_mismatch(person, hitf):
            result = result[:3] + ([ident_id],)
        return result

    n_ok = name_agrees(person, hitf, bank, use_verified=True)
    # If no verified name, agreement uses declared names
    if not person.get("verified_name"):
        n_ok = name_agrees(person, hitf, bank, use_verified=False)
    # Individual with <2 real parts on the name we would confirm with: cannot confirm or clear on name
    name_for_parts = person.get("verified_name") or ((person.get("names") or [None])[0])
    company = is_company(person.get("entity_type"))
    too_few_parts = (
        is_person(person.get("entity_type"))
        and name_for_parts
        and len(bank.ns.parts(name_for_parts, company=False)) < 2
    )
    if too_few_parts:
        n_ok = False

    d_ok = dob_agrees(person, hitf)
    l_ok = location_agrees(person, hitf)
    l_mis = location_mismatch(person, hitf)
    linkage = splink_style_profile(person, hitf, bank, n_ok, d_ok, l_ok, l_mis)
    # Safety valve: if either side has a country value we cannot read, it might be
    # the country they share, so the recognised countries differing proves nothing.
    # Such a hit is neither cleared nor confirmed on location.
    unread = list(person.get("unrecognised_countries") or []) + list(
        hitf.get("unrecognised_countries") or [])
    loc_unsure = l_mis and bool(unread)
    if loc_unsure:
        l_mis = False

    # Location mismatch, except when name and DOB agree -> REVIEW
    if l_mis and not (n_ok and d_ok):
        return pack(
            "DIFFERENT_ENTITY",
            "LOCATION_MISMATCH",
            f"The customer is linked only to {', '.join(person.get('countries') or [])} but the hit is linked only to {', '.join(hitf.get('countries') or [])}.",
            l_mis=True,
        )

    # Confirm
    if is_company(person.get("entity_type")) or is_company(hitf.get("entity_type")):
        if n_ok and l_ok and linkage["score"] >= linkage["threshold"]:
            return pack(
                "SAME_ENTITY",
                "NAME_LOCATION_MATCH",
                f"Both the customer and the hit are linked to {', '.join(sorted(set(person.get('countries') or []) & set(hitf.get('countries') or [])))}. The customer's name agrees with the hit's name {(hitf.get('names') or ['the listed name'])[0]}.",
                l_ok=True,
            )
    else:
        if n_ok and d_ok and not l_mis and not loc_unsure and linkage["score"] >= linkage["threshold"]:
            # name+DOB agree; country difference would have been REVIEW via l_mis and (n_ok and d_ok)
            key = "NAME_DOB_LOCATION_MATCH" if l_ok else "NAME_DOB_MATCH"
            ciso = person.get("dob").iso() if person.get("dob") else "unknown"
            hiso = ", ".join(d.iso() for d in hitf.get("dobs") or [])
            extra = f" Both the customer and the hit are linked to {', '.join(sorted(set(person['countries']) & set(hitf['countries'])))}." if l_ok else ""
            return pack(
                "SAME_ENTITY",
                key,
                f"The customer's date of birth {ciso}{ident_cite(ident)} agrees with the hit's {hiso}.{extra} The customer's name agrees with the hit's name {(hitf.get('names') or ['the listed name'])[0]}.",
                l_ok=l_ok,
            )

    # Name+DOB agree but countries all differ -> REVIEW (already excluded SAME and LOCATION)
    missing = []
    if not person.get("dob") or not (hitf.get("dobs") or []):
        missing.append("the date of birth cannot be compared with it")
    detail = "Nothing in the customer's records contradicts the hit"
    if n_ok:
        detail += f", and the customer's name agrees with the hit's name {(hitf.get('names') or ['the listed name'])[0]}"
    if missing:
        detail += ", and " + " and ".join(missing)
    detail += ", so the hit can be neither cleared nor confirmed."
    if loc_unsure:
        detail = (
            f"The recognised countries differ (customer: {', '.join(person.get('countries') or [])}; "
            f"hit: {', '.join(hitf.get('countries') or [])}), but the country value "
            f"{', '.join(repr(u) for u in unread)} could not be read, so location cannot clear the hit. "
            + detail
        )
    if l_ok:
        detail = (
            f"Both the customer and the hit are linked to {', '.join(sorted(set(person.get('countries') or []) & set(hitf.get('countries') or [])))}. "
            + detail
        )
    return pack("REVIEW", "INSUFFICIENT_DATA", detail, l_ok=l_ok, l_mis=l_mis)


def compose_reason(person, hitf, result, ambiguous, same_decision, bank):
    decision, key, detail, _ev = result
    # 2-4 sentences naming this hit's facts. Count real sentences, not list items:
    # a detail string may already contain two or three sentences.
    chunks = []
    if ambiguous:
        ids = ", ".join(person.get("all_ids") or person.get("record_ids") or [])
        if same_decision:
            chunks.append(f"More than one person in the system of record fits this alert ({ids}); each is decided separately and they lead to the same decision.")
        else:
            chunks.append(f"More than one person in the system of record fits this alert ({ids}) and they lead to different decisions.")
    if detail:
        chunks.append(detail)
    if decision == "REVIEW" and key == "INSUFFICIENT_DATA":
        gaps = []
        if not person.get("dob"):
            gaps.append("the customer has no usable date of birth")
        if not (hitf.get("dobs") or []):
            gaps.append("the hit has no usable date of birth")
        if not (person.get("countries") or []):
            gaps.append("the customer has no tied country")
        if not (hitf.get("countries") or []):
            gaps.append("the hit has no tied country")
        if gaps:
            chunks.append("Missing from the comparison: " + "; ".join(gaps) + ".")
    sentences = []
    for chunk in chunks:
        sentences.extend(_sentences(chunk) or ([chunk.strip()] if chunk and str(chunk).strip() else []))
    sentences = [s if s.endswith((".", "!", "?")) else s + "." for s in sentences if s]
    if len(sentences) < 2:
        cname = person.get("verified_name") or ((person.get("names") or ["the customer"])[0] or "the customer")
        hname = (hitf.get("names") or ["the listed profile"])[0] or "the listed profile"
        sentences.append(f"The customer is {cname}; the listed profile is {hname}.")
        sentences = _sentences(" ".join(sentences)) or sentences
        sentences = [s if s.endswith((".", "!", "?")) else s + "." for s in sentences if s]
    return " ".join(sentences[:4])


def decide_hit(alert, hit, bank):
    people = resolve_people(alert, bank)
    hitf = extract_hit(hit, bank)
    aid = hit.get("alert_id") or (alert.get("alert_id") if alert else None)
    hid = hit.get("hit_id")

    if not people:
        # no customer record found
        reason = (
            "No customer record could be resolved from the alert's link or from the screened details. "
            "Without a customer picture the hit can be neither cleared nor confirmed."
        )
        return {
            "hit_id": hid,
            "alert_id": aid,
            "decision": "REVIEW",
            "reason_code": "INSUFFICIENT_DATA",
            "customer_record_id": None,
            "reason": reason,
            "evidence": [],
        }

    results = [decide_one(p, hitf, alert, bank) for p in people]
    if len(people) == 1:
        person = people[0]
        decision, key, detail, ev = results[0]
        reason = compose_reason(person, hitf, results[0], False, True, bank)
        return {
            "hit_id": hid,
            "alert_id": aid,
            "decision": decision,
            "reason_code": key,
            "customer_record_id": person["customer_record_id"],
            "reason": reason,
            "evidence": ev,
        }

    # Several people: if they all lead to the same decision, give it, else REVIEW / AMBIGUOUS
    # customer_record_id is AMBIGUOUS either way
    decisions = [r[0] for r in results]
    all_ids = []
    for p in people:
        all_ids.extend(p["record_ids"])
    # pick a representative person (first by id) for reason text
    for p, r in zip(people, results):
        p["all_ids"] = all_ids
    if len(set(decisions)) == 1:
        # same decision — if reason codes differ, any accepted; pick first
        # merge evidence
        ev, seen = [], set()
        for r in results:
            for x in r[3]:
                if x not in seen:
                    seen.add(x)
                    ev.append(x)
        # prefer a result whose code is common if possible
        codes = [r[1] for r in results]
        chosen = results[0]
        for r in results:
            if codes.count(r[1]) == len(results):
                chosen = r
                break
        decision, key, detail, _ = chosen
        reason = compose_reason(people[0], hitf, (decision, key, detail, ev), True, True, bank)
        return {
            "hit_id": hid,
            "alert_id": aid,
            "decision": decision,
            "reason_code": key,
            "customer_record_id": "AMBIGUOUS",
            "reason": reason,
            "evidence": ev,
        }

    # different decisions
    ev, seen = [], set()
    ev.append(hid) if False else None
    for p in people:
        for rid in p["record_ids"]:
            if rid not in seen:
                seen.add(rid)
                ev.append(rid)
    reason = compose_reason(
        people[0], hitf,
        ("REVIEW", "AMBIGUOUS_CUSTOMER_RECORD",
         "The people who fit the alert do not all lead to the same decision for this hit.", ev),
        True, False, bank,
    )
    return {
        "hit_id": hid,
        "alert_id": aid,
        "decision": "REVIEW",
        "reason_code": "AMBIGUOUS_CUSTOMER_RECORD",
        "customer_record_id": "AMBIGUOUS",
        "reason": reason,
        "evidence": ev,
    }


def _hits_root(data_folder):
    root = Path(data_folder)
    if not (root / "alerts.jsonl").exists() and (root / "dev" / "alerts.jsonl").exists():
        root = root / "dev"
    return root


def _ordered_hits(hits):
    """Exactly one output slot per hit_id, stable order; keep rows with no id too."""
    seen = set()
    unique, anonymous = [], []
    for hit in hits:
        if not isinstance(hit, dict):
            continue
        hid = hit.get("hit_id")
        if not hid:
            anonymous.append(hit)
            continue
        if hid in seen:
            continue
        seen.add(hid)
        unique.append(hit)
    unique.sort(key=lambda h: h.get("hit_id") or "")
    return unique + anonymous


def run(data_folder, output_file):
    root = _hits_root(data_folder)
    bank = None
    load_error = None
    try:
        bank = load_bank(data_folder)
        hits = list(bank.hits)
    except Exception as exc:
        load_error = exc
        bank = None
        hits = read_jsonl(root / "hits.jsonl")
    hits = _ordered_hits(hits)
    rows = []
    for hit in hits:
        alert = {}
        try:
            if bank is None:
                raise RuntimeError(f"failed to load data folder: {load_error}")
            alert = bank.alerts_by_id.get(hit.get("alert_id")) or {}
            row = decide_hit(alert, hit, bank)
            if not isinstance(row, dict) or row.get("hit_id") != hit.get("hit_id"):
                row = fallback_prediction(hit, alert)
            # Guarantee a complete, valid-shaped line even if decide_hit returned a partial.
            for k, v in fallback_prediction(hit, alert).items():
                row.setdefault(k, v)
        except Exception:
            row = fallback_prediction(hit, alert)
        rows.append(row)
    out = Path(output_file)
    out.parent.mkdir(parents=True, exist_ok=True)
    with out.open("w", encoding="utf-8") as fh:
        for row in rows:
            fh.write(json.dumps(row, ensure_ascii=False, separators=(", ", ": ")))
            fh.write("\n")
    return len(rows)


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if len(argv) != 2:
        print("Usage: system/run <data_folder> <output_file>", file=sys.stderr)
        return 2
    n = run(argv[0], argv[1])
    print(f"wrote {n} predictions to {argv[1]}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
