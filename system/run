# ISO2 / adjectives / aliases -> canonical English country name.
# Territories stay their own country. Codes and nationalities are countries.
COUNTRY_MAP = {}

def _add_country(canon, *aliases):
    COUNTRY_MAP[canon.lower()] = canon
    for a in aliases:
        COUNTRY_MAP[a.lower()] = canon

