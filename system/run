#!/usr/bin/env python3
"""Run the screening pipeline and deterministic decision engine."""

import json
import os
import sys

from data_pipeline import load_data_store, prepare_hit_context
from decision_engine import evaluate_context


def read_jsonl(path):
    with open(path, "r", encoding="utf-8") as handle:
        return [json.loads(line) for line in handle if line.strip()]


def main(argv):
    if len(argv) != 3:
        print("usage: ./run <data_folder> <output_file>", file=sys.stderr)
        return 2
    data_folder, output_file = argv[1], argv[2]
    store = load_data_store(data_folder)
    alerts = {row["alert_id"]: row for row in read_jsonl(os.path.join(data_folder, "alerts.jsonl"))}
    hits = read_jsonl(os.path.join(data_folder, "hits.jsonl"))
    with open(os.path.join(data_folder, "name_variants.json"), "r", encoding="utf-8") as handle:
        variants = json.load(handle)
    output_dir = os.path.dirname(os.path.abspath(output_file))
    os.makedirs(output_dir, exist_ok=True)
    with open(output_file, "w", encoding="utf-8", newline="\n") as handle:
        for hit in hits:
            alert = alerts.get(hit.get("alert_id"), {})
            context = prepare_hit_context(alert, hit, store)
            candidates = context.get("candidate_contexts") or []
            if len(candidates) > 1:
                candidate_results = [evaluate_context(candidate, variants) for candidate in candidates]
                if len({item["decision"] for item in candidate_results}) == 1:
                    result = candidate_results[0]
                    result["customer_record_id"] = "AMBIGUOUS"
                else:
                    context["is_ambiguous"] = True
                    result = evaluate_context(context, variants)
            else:
                result = evaluate_context(context, variants)
            handle.write(json.dumps(result, ensure_ascii=False, separators=(",", ":")) + "\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
